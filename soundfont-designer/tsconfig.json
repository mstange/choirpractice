{
	"extends": "@tsconfig/svelte/tsconfig.json",
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"types": ["vite/client", "node"],
		"lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"]
	},
	"include": ["src", "scripts", "vite.config.ts"]
}
